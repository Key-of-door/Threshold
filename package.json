{
  "name": "threshold-lite",
  "version": "0.2.0-alpha.2",
  "description": "A small local project service for persistent collaboration across independent Pi agent sessions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Key-of-door/Threshold.git"
  },
  "bugs": {
    "url": "https://github.com/Key-of-door/Threshold/issues"
  },
  "homepage": "https://github.com/Key-of-door/Threshold#readme",
